# Referenced by services.hermes-agent.environmentFiles in
# roles/hermes/files/nixos/configuration.nix. Deliberately NOT part of the flake
# tree: everything a Nix expression touches ends up in /nix/store, which is
# world-readable, so the module types environmentFiles as `str` rather than `path`
# to keep this a runtime file that the store never sees.
#
# Activation copies these lines into $HERMES_HOME/.env, rewriting it from scratch
# each time — which is why config_hermes.yml both rebuilds and restarts when this
# file changes. Non-secret variables live in configuration.nix's
# services.hermes-agent.environment instead, where they are reviewable in git.
API_SERVER_KEY={{ hermes_proxy_key }}
