{{ ansible_managed | comment }}
# EnvironmentFile of the hermes-linear-poller unit (files/nixos/configuration.nix).
# Client credentials of the Hermes Linear OAuth app. The poller exchanges them
# for the app's 30-day access token (cached in credentials/linear-token.json)
# and hands that token on to the worker profile.
LINEAR_CLIENT_ID={{ hermes_linear_client_id }}
LINEAR_CLIENT_SECRET={{ hermes_linear_client_secret }}
