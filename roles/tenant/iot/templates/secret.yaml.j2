# {{ ansible_managed }}
# Zigbee2MQTT secrets, referenced as `!secret <key>` from configuration.yaml (rendered by
# files/nixos/configuration.nix). JSON values are valid YAML.
mqtt_password: {{ iot_mqtt_passwords.z2m | to_json }}
network_key: {{ iot_zigbee_network_key | map('int') | list | to_json }}
frontend_token: {{ iot_z2m_frontend_token | to_json }}
