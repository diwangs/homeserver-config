# {{ ansible_managed }}
# Public identity for configuration.nix, rendered from the vault (group_vars/all/
# vars.yml) so the domains never sit in the committed flake tree. JSON string
# literals are valid Nix strings, hence to_json for quoting.
{
  serverName = {{ matrix_server_name | to_json }};
  hostName = {{ matrix_hostname | to_json }};
  # The public edge (roles/tenant/bunkerweb), the only client allowed on port 80.
  edgeAddress = {{ hostvars['bunkerweb'].ansible_host | to_json }};
}
