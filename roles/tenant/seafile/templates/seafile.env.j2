{{ ansible_managed | comment }}
# Runtime-only (root:root 0400), read by `docker run --env-file` for seafile
# (files/nixos/configuration.nix). Never part of the flake tree or the Nix store.
# INIT_* values are only consumed on the very first start, while /shared is empty.
SEAFILE_MYSQL_DB_PASSWORD={{ seafile_db_password }}
INIT_SEAFILE_MYSQL_ROOT_PASSWORD={{ seafile_db_root_password }}
INIT_SEAFILE_ADMIN_EMAIL={{ seafile_admin_email }}
INIT_SEAFILE_ADMIN_PASSWORD={{ seafile_admin_password }}
JWT_PRIVATE_KEY={{ seafile_jwt_private_key }}
