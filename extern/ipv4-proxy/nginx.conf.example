# Template: copy to nginx.conf (gitignored) and replace the example.org /
# example.com placeholders with the real hostnames (vault: vault_public_domain,
# vault_matrix_server_name). The Dockerfile COPYs nginx.conf, not this file.

worker_processes auto;
events {}

http {
  resolver 1.1.1.1 valid=15s ipv6=on ipv4=off;

  # The DNS-only A record points back to this Fly app. Resolve only the direct
  # AAAA record so the ACME challenge reaches CT108 instead of looping here.
  map $host $acme_origin {
    hermes.example.org hermes.example.org:80;
    default "";
  }

  server {
    listen 80 default_server;
    if ($acme_origin = "") { return 444; }

    location ^~ /.well-known/acme-challenge/ {
      proxy_set_header Host $host;
      proxy_pass http://$acme_origin;
    }

    location / {
      return 308 https://$host$request_uri;
    }
  }
}

stream {
  resolver 1.1.1.1 valid=15s ipv6=on ipv4=off;   # explicit resolver, re-check every 15s

  # Shared IPv4 ingress for the dmz's AAAA-only tenants. Each points its own A
  # record at this one Fly app rather than paying for and running a dedicated
  # IPv4 + machine per service. ssl_preread reads the SNI hostname out of the TLS
  # ClientHello without terminating the handshake, so proxy_pass forwards the
  # still-encrypted bytes straight through — the real backend negotiates TLS
  # directly with the client, and this proxy never sees plaintext.
  map $ssl_preread_server_name $origin {
    nextcloud.example.org   nextcloud.example.org:443;
    matrix.example.org   matrix.example.org:443;
    hermes.example.org   hermes.example.org:443;
    # Anything else — no SNI, or a hostname not listed above — is sent to a closed
    # local port rather than silently falling back to one tenant's backend. nginx
    # gets an instant ECONNREFUSED and resets the client; nothing is forwarded.
    default                    127.0.0.1:1;
  }

  server {
    listen 443;
    ssl_preread on;
    proxy_pass $origin;
  }

  # Matrix federation. A single-purpose port carries only one tenant's traffic —
  # every connection here is federation for example.com — so no SNI branching is
  # needed, unlike 443 above.
  server {
    listen 8448;
    proxy_pass matrix.example.org:8448;
  }
}
