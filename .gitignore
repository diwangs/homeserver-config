# Ansible vault password — NEVER commit
.vault_pass
*.vault_pass

# Ansible runtime
*.retry
.ansible/

# Editor / OS
*.swp
.DS_Store
.vscode

# Automation SSH identity — private half NEVER commit, public half is tracked
.ssh/*
!.ssh/*.pub


# Rendered by Ansible from the vault into the flake build/deploy copies; never
# belongs in the source tree
roles/tenant/*/files/nixos/site.nix

# Python bytecode from the offline role tests
__pycache__/
